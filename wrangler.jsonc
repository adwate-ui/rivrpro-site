{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivrpro-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "EMAIL" }],
  // At most 3 enquiry emails a minute from one address (counted only once an enquiry passes every check).
  "ratelimits": [{ "name": "ENQUIRY_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  // Public values only: the repo is public. TURNSTILE_SECRET and ENQUIRY_TO are Worker secrets.
  "vars": { "ENQUIRY_FROM": "enquiries@rivrpro.com" },
  "observability": { "enabled": true },
  // workers.dev is the hidden preview until launch (then false). No per-version preview URLs: they would run with
  // the production secrets and email binding.
  "workers_dev": true,
  "preview_urls": false
}
